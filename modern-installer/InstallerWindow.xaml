<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:media="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
        Title="译澜 安装" Width="1000" Height="680" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#F6F8FF"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
  <Window.Resources>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#61E7D2" Offset="0" />
      <GradientStop Color="#42A9FF" Offset="0.52" />
      <GradientStop Color="#8A6CFF" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="GlassButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E9F4FF" />
      <Setter Property="Background" Value="#18FFFFFF" />
      <Setter Property="BorderBrush" Value="#32FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" CornerRadius="16" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="#2AFFFFFF" />
                <Setter TargetName="Shell" Property="BorderBrush" Value="#65FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shell" Property="Opacity" Value="0.76" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shell" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="#9CFFFFFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="26,15" />
    </Style>
    <Storyboard x:Key="IntroStoryboard">
      <DoubleAnimation Storyboard.TargetName="MainContent" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.65" />
      <DoubleAnimation Storyboard.TargetName="ContentTranslate" Storyboard.TargetProperty="Y"
                       From="22" To="0" Duration="0:0:0.75">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="GlowOne" Storyboard.TargetProperty="Opacity"
                       From="0" To="0.72" Duration="0:0:1.1" />
    </Storyboard>
  </Window.Resources>

  <Grid x:Name="RootGrid" Background="Transparent">
    <Grid.Clip>
      <RectangleGeometry Rect="0,0,1000,680" RadiusX="26" RadiusY="26" />
    </Grid.Clip>
    <Border Margin="0" CornerRadius="26" BorderThickness="1" BorderBrush="#36FFFFFF" ClipToBounds="True"
            RenderOptions.ClearTypeHint="Enabled">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF08101F" Offset="0" />
          <GradientStop Color="#FF0A1727" Offset="0.5" />
          <GradientStop Color="#FF171128" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="50" /></Grid.RowDefinitions>
        <Ellipse x:Name="GlowOne" Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="24,16,0,0" Opacity="0.58" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush><GradientStop Color="#6638F3D0" Offset="0" /><GradientStop Color="#0038F3D0" Offset="1" /></RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Effect><media:BlurEffect Radius="64" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,18,12" Opacity="0.56" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush><GradientStop Color="#5A5D49FF" Offset="0" /><GradientStop Color="#005D49FF" Offset="1" /></RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Effect><media:BlurEffect Radius="72" /></Ellipse.Effect>
        </Ellipse>
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
            <Border Width="42" Height="42" CornerRadius="13" BorderBrush="#76FFFFFF" BorderThickness="1">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#74EBD4" /><GradientStop Color="#7A65F4" Offset="1" /></LinearGradientBrush></Border.Background>
              <TextBlock Text="译" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="译澜" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="YILAN · OFFLINE TRANSLATION" Foreground="#7791AA" FontSize="10" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
            <Button x:Name="MinimizeButton" Style="{StaticResource GlassButton}" Width="44" Height="38" Padding="0" Margin="0,0,8,0" Content="—" FontSize="17" />
            <Button x:Name="CloseButton" Style="{StaticResource GlassButton}" Width="44" Height="38" Padding="0" Content="×" FontSize="22" />
          </StackPanel>
        </Grid>

        <Grid x:Name="MainContent" Grid.Row="1" Margin="44,16,44,20" Opacity="0">
          <Grid.RenderTransform><TranslateTransform x:Name="ContentTranslate" /></Grid.RenderTransform>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.03*" /><ColumnDefinition Width="0.97*" /></Grid.ColumnDefinitions>

          <StackPanel VerticalAlignment="Center" Margin="10,0,54,0">
            <Border HorizontalAlignment="Left" CornerRadius="14" Padding="12,7" Background="#16FFFFFF" BorderBrush="#36FFFFFF" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#55DFA4" Margin="0,0,8,0" />
                <TextBlock Text="v1.6.0 · 完整离线版" Foreground="#B9CADB" FontSize="11" />
              </StackPanel>
            </Border>
            <TextBlock Text="让语言，在本地&#x0a;自然流动。" FontSize="48" FontWeight="Bold" LineHeight="60" Margin="0,25,0,0">
              <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" /><GradientStop Color="#B9D9FF" Offset="0.56" /><GradientStop Color="#96E9DA" Offset="1" /></LinearGradientBrush></TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="无需联网，不上传文本。独显、集显与 CPU 均可使用，&#x0a;安装完成即可进行中英句子互译与逐词查义。"
                       Foreground="#8FA4BA" FontSize="14" LineHeight="25" Margin="0,20,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
              <Border CornerRadius="18" Background="#12FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="14,10" Margin="0,0,10,0"><TextBlock Text="◈  全程离线" Foreground="#B7C9DB" /></Border>
              <Border CornerRadius="18" Background="#12FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="14,10"><TextBlock Text="✦  自适应推理" Foreground="#B7C9DB" /></Border>
            </StackPanel>
          </StackPanel>

          <Border Grid.Column="1" CornerRadius="28" Margin="0,8,-4,-8" Background="#02000000" IsHitTestVisible="False">
            <Border.Effect><media:DropShadowEffect BlurRadius="42" ShadowDepth="10" Opacity="0.28" Color="#000000" /></Border.Effect>
          </Border>
          <Border Grid.Column="1" CornerRadius="28" Padding="30" BorderBrush="#40FFFFFF" BorderThickness="1" Background="#1CFFFFFF">
            <Grid>
              <Grid x:Name="SetupPanel">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="准备安装译澜" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="选择一个父文件夹，译澜会自动创建 Yilan 子文件夹。磁盘根目录同样可选。" Foreground="#92A7BC" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0" />
                <TextBlock Grid.Row="2" Text="安装到" Foreground="#C6D5E4" FontWeight="SemiBold" Margin="0,28,0,9" />
                <Grid Grid.Row="3">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border CornerRadius="15" Background="#2306101D" BorderBrush="#3DFFFFFF" BorderThickness="1" Padding="14,0">
                    <TextBox x:Name="PathTextBox" Height="48" BorderThickness="0" Background="Transparent" Foreground="#EDF5FF" CaretBrush="#66E4D0" FontSize="13" VerticalContentAlignment="Center" />
                  </Border>
                  <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource GlassButton}" Content="浏览" Margin="10,0,0,0" Width="76" />
                </Grid>
                <StackPanel Grid.Row="4" Margin="0,16,0,0">
                  <TextBlock Text="实际目录" Foreground="#667C93" FontSize="11" />
                  <TextBlock x:Name="TargetPreview" Text="—" Foreground="#90E7D7" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                  <Border Margin="0,22,0,0" CornerRadius="14" Background="#101DE1B9" BorderBrush="#2B49EBC8" BorderThickness="1" Padding="13,10">
                    <TextBlock Text="约需 1.8 GB 空间 · 安装后不再保留安装包副本" Foreground="#A7C9C6" FontSize="11" />
                  </Border>
                </StackPanel>
                <Button x:Name="InstallButton" Grid.Row="5" Style="{StaticResource PrimaryButton}" Content="开始安装  →" Height="56" />
              </Grid>

              <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <Border Width="82" Height="82" CornerRadius="26" HorizontalAlignment="Center" BorderBrush="#71FFFFFF" BorderThickness="1">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6BE6D2" /><GradientStop Color="#745FF1" Offset="1" /></LinearGradientBrush></Border.Background>
                    <TextBlock x:Name="ProgressGlyph" Text="译" FontSize="39" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock x:Name="ProgressTitle" Text="正在准备安装" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,0" />
                  <TextBlock x:Name="ProgressStatus" Text="正在验证离线组件…" Foreground="#8FA4BA" HorizontalAlignment="Center" Margin="0,9,0,0" />
                  <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="16,30,16,0" Foreground="#60E5D0" Background="#23000000" BorderThickness="0" />
                  <TextBlock x:Name="InstallLocationText" Foreground="#667C93" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,13,16,0" />
                </StackPanel>
                <Button x:Name="FinishButton" Grid.Row="1" Style="{StaticResource PrimaryButton}" Content="打开译澜  →" Height="56" Visibility="Collapsed" />
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="30,0">
          <TextBlock Text="Designed By MOFAN" Foreground="#4F647A" FontSize="10" VerticalAlignment="Center" />
          <TextBlock Text="本地安装 · 不连接网络" Foreground="#4F647A" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
